{
  // Display name for this crew
  "name": "tinge-agents",

  // Agents to include — each must have a matching agents/<name>.jsonc file
  "agents": ["productrequirements_agent",
              "architect_agent",
              "frontend_agent",
              "backend_agent",
              "testing_agent",
              "code_reviewer_agent"],

  // Task definitions — executed in order for sequential process
  "tasks": [
    {
      // Task identifier
      "name": "requirements_task",

      // What the task should accomplish
      // Use {placeholder} inputs here; crewai run prompts for missing values
      "description": "The current working directory is the root of the project being built. Use the current working directory (.) as the project root for any local file operations. Only access files and directories inside the current project. Do not access system root directories, parent directories, or directories outside the project. Analyze the user's application request: {app_description} Turn it into clear, specific, and testable software requirements. Identify the core features, users, inputs, outputs, constraints, business rules, and acceptance criteria. If an existing project is provided and local project inspection is necessary, only use appropriate local file and directory tools for local files; never use SerperDevTool, WebsiteSearchTool, ScrapeElementFromWebsiteTool, or any other web tool to read local files or directories. Web tools may only be used for genuine external HTTP or HTTPS websites when external research is necessary. Never pass requirements.md, file paths, relative paths, file:// URLs, or the project directory to a web tool. Do not make implementation decisions that belong to the Architect or developers. Focus on defining WHAT the application must do, not HOW it should be implemented. Provide a clear and complete set of requirements for the app {app_name} that can be used by the Architect and developers to design and implement the application. After completing the requirements analysis, use FileWriterTool to create or overwrite requirements.md in the current project root. This file must contain only the finalized requirements needed by downstream agents. Do not include internal reasoning, planning, tool history, or exploratory analysis. Do not consider the task complete until requirements.md has been successfully written.",
      // Clear definition of what the output should look like
      "expected_output": "A complete software requirements specification that clearly defines what the application needs to do, including existing functionality that should be preserved or modified.",

      // Optional task guardrail(s) validate output before completion
      // Use "guardrail" for one rule or "guardrails" for many
      // Failed guardrails retry up to guardrail_max_retries times
      // "guardrail": "Every factual claim needs context support.",
      // "guardrails": [
      //   "Every factual claim must be supported by context.",
      //   "The answer must match the expected output format."
      // ],
      // "guardrail_max_retries": 2,

      // Advanced task options:
      // Docs: https://docs.crewai.com/concepts/tasks
      // "type": "ConditionalTask",
      // "condition": { "python": "my_project.conditions.should_run" },
      // "output_json": { "python": "my_project.models.ReportOutput" },
      // "output_pydantic": null,
      // "response_model": null,
      // "converter_cls": { "python": "my_project.converters.CustomConverter" },
      // "markdown": false,
      // "input_files": { "brief": "data/brief.txt" },
      // "security_config": {},

      // Which agent handles this task
      "agent": "productrequirements_agent"

      // "tools": [],
      // "human_input": false,
      // "async_execution": false
    },
    {
      "name": "architecture_task",
      "description": "The current working directory is the root of the project being built. Use the current working directory (.) as the project root for all DirectoryReadTool, FileReadTool, and FileWriterTool operations. Only access files and directories inside the current project. Do not access system root directories, parent directories, or directories outside the project. Do not guess or repeatedly probe directories such as src, app, backend, or server unless they are discovered in the project root listing or referenced by an existing configuration file. Use FileReadTool exclusively for local project files and never use web search or website tools to read local files. First list the project root once using DirectoryReadTool, then read requirements.md using FileReadTool. Treat requirements.md as the authoritative handoff from the Product/Requirements Agent. Determine whether the project is new, empty, or an existing application. If the project is new or empty, design the architecture from requirements.md. If existing code is present, inspect only the minimum relevant files and directories needed to identify the existing technology stack, frameworks, dependencies, components, APIs, database structures, configuration, authentication, conventions, and functionality. Do not perform an exhaustive repository inspection, repeatedly inspect directories that do not exist, use wildcards such as ./*, or continue exploring once sufficient information has been gathered to design the architecture. Preserve appropriate existing architecture and working functionality rather than unnecessarily replacing it. Design an implementation-ready technical architecture based on requirements.md and the actual project state, including the technology stack, database and data model, APIs, frontend and backend components, data flow, component relationships, authentication, authorization, security, and implementation structure. Clearly identify files and components to preserve, modify, and create. Once sufficient information has been gathered, immediately use FileWriterTool to create architecture.md in the current project root. Do not delay creation of architecture.md for additional exploration. architecture.md must contain only the finalized, concise, implementation-ready architecture needed by downstream agents and must not contain internal reasoning, planning steps, tool history, exploratory analysis, or unnecessary commentary. After writing architecture.md, immediately use FileReadTool to verify that architecture.md exists and contains the finalized architecture. If verification fails, use FileWriterTool to create or correct architecture.md and verify it again. Do not consider the task complete until architecture.md has been successfully created and verified. Do not perform additional exhaustive project inspection after architecture.md has been successfully verified.",
      "expected_output": "A detailed, implementation-ready technical architecture describing the technology stack, database/data model, APIs, components, data flow, authentication, security, and implementation structure, including which existing files should be preserved, modified, or created.",
      "agent": "architect_agent",
      "context": ["requirements_task"]    
    },    
    {
      "name": "frontend_task",
      "description": "Before making any implementation decisions, read requirements.md and architecture.md from the current project root using FileReadTool. These files are the authoritative handoff documents from the Requirements and Architect agents. Do not rely on or reconstruct previous agents' conversations, reasoning, plans, or tool history. Use the current working directory (.) as the project root for all file and directory operations. Only access files and directories inside the current project; do not access system root directories, parent directories, or directories outside the project. First list the project root using DirectoryReadTool and only inspect files and directories actually discovered there or referenced by existing configuration files. Do not guess common directories such as src, app, frontend, or pages and do not use wildcards such as ./*. Use FileReadTool exclusively for local project files and never use web search or website scraping tools to read local files. Identify the existing frontend framework, dependencies, components, routing, styling, state management, API integration, and current functionality. Follow requirements.md and architecture.md and preserve appropriate existing functionality and project conventions. This is a direct implementation task, not a planning or documentation task. You MUST create or modify the actual frontend source files in the project using FileWriterTool, including components, pages, routes, styling, configuration, API integration, and other files required by the approved architecture. Do not merely describe the implementation, provide proposed code in the final response, or create only a report. The actual application source files must be written to the project before the task is considered complete. After implementation, use DirectoryReadTool and FileReadTool to verify that the expected frontend source files were actually created or modified. Run the appropriate frontend build or tests if an available execution tool supports them; if no execution tool is available, do not claim that validation was performed. Fix any errors that can be verified and then provide a concise implementation summary. Do not consider the task complete until the required frontend source files have been created or modified. f architecture.md does not exist, do not invent an architecture or perform an exhaustive search for it. Re-read the project root and requirements.md, then report that the required architecture handoff is missing and do not begin implementation.",
      "expected_output": "A functional implementation in the actual project files that satisfies the requirements, follows teh approved architecture, preserves appropriate existing functionality if applicable, and successfully builds or passes the relevant tests.",
      "agent": "frontend_agent",
      "context": ["architecture_task"]    
    },
    {
      "name": "backend_task",
      "description": "Before making any implementation decisions, read requirements.md and architecture.md from the current project root using FileReadTool. These files are the authoritative handoff documents from the Requirements and Architect agents. Do not rely on or reconstruct previous agents' conversations, reasoning, plans, or tool history. Use the current working directory (.) as the project root for all file and directory operations. Only access files and directories inside the current project; do not access system root directories, parent directories, or directories outside the project. First list the project root using DirectoryReadTool and only inspect files and directories actually discovered there or referenced by existing configuration files. Do not guess common directories such as backend, server, api, or src and do not use wildcards such as ./*. Use FileReadTool exclusively for local project files and never use web search or website scraping tools to read local files. Identify the existing backend framework, dependencies, API structure, database configuration, models, authentication, services, and current functionality. Follow requirements.md and architecture.md and preserve appropriate existing functionality and project conventions. This is a direct implementation task, not a planning or documentation task. You MUST create or modify the actual backend source files in the project using FileWriterTool, including API routes, controllers, services, models, database schemas or migrations, authentication, authorization, configuration, and other files required by the approved architecture. Do not merely describe the implementation, provide proposed code in the final response, or create only a report. The actual application source files must be written to the project before the task is considered complete. After implementation, use DirectoryReadTool and FileReadTool to verify that the expected backend source files were actually created or modified. Run the appropriate backend build, tests, or application commands if an available execution tool supports them; if no execution tool is available, do not claim that validation was performed. Fix any errors that can be verified and then provide a concise implementation summary. Do not consider the task complete until the required backend source files have been created or modified. f architecture.md does not exist, do not invent an architecture or perform an exhaustive search for it. Re-read the project root and requirements.md, then report that the required architecture handoff is missing and do not begin implementation.",
      "expected_output": "A functional backend implementation in the actual project files that satisfies the requirements, follows the approved architecture, preserves appropriate existing functionality, and successfully runs or passes the relevant tests.",
      "agent": "backend_agent",
      "context": ["architecture_task"]
    },
    {
      "name": "testing_task",
      "description": "The current working directory is the root of the project being built. Use the current working directory (.) as the project root when using file or directory tools. Only access files and directories inside the current project. Do not access /, /app, or directories outside the project. Test the actual application and inspect the project files created or modified by the frontend and backend agents. Begin by reviewing the requirements and architecture, then inspect the relevant source code, project structure, configuration, and tests. Run the application, build process, and available automated tests using the appropriate tools. Verify that the implementation satisfies the requirements and that the frontend, backend, APIs, database interactions, and major user workflows function correctly. Test normal use cases, invalid inputs, edge cases, error handling, and integration points. Identify the likely cause of failures and document specific files or components involved. Do not assume the application works based only on the previous agents' outputs.",
      "expected_output": "A detailed test report based on actual execution and project inspection, identifying passed requirements, failed tests, bugs, affected files or components, edge cases, integration issues, and recommended fixes.",
      "agent": "testing_agent",
      "context": ["architecture_task"]
    },
    {
      "name": "code_review_task",
      "description": "The current working directory is the root of the project being built. Use the current working directory (.) as the project root when using file or directory tools. Only access files and directories inside the current project. Do not access /, /app, or directories outside the project.Review the completed application by inspecting the actual project files, source code, configuration, dependencies, and relevant tests. Review the original requirements, approved architecture, and testing results, then compare them against the actual implementation. Evaluate the implementation for correctness, security, maintainability, code quality, architectural consistency, error handling, and unnecessary complexity. Identify any remaining bugs, security vulnerabilities, architectural violations, poor practices, or maintainability concerns that should be addressed before the application is considered complete. Do not rely solely on the testing report or previous agents' descriptions; independently inspect the implementation.",
      "expected_output": "A comprehensive code review based on the actual implementation, identifying security issues, bugs, architectural problems, maintainability concerns, deviations from requirements or architecture, and prioritized recommendations for final fixes.",
      "agent": "code_reviewer_agent",
      "context": ["testing_task"]
    }
  ],

  // Execution process
  // "sequential" — tasks run in order, each receiving prior task outputs
  // "hierarchical" — a manager agent delegates tasks (requires manager_llm)
  "process": "sequential",

  // Enable verbose logging during execution
  "verbose": true,

  // Enable crew memory — persists context and learnings across tasks
  "memory": false,

  // Automatically plan the execution strategy before running tasks
   "planning": true,

  // LLM for the planning step (used when planning is true)
  // "planning_llm": "openai/gpt-4o",

  // LLM for the manager agent (required when process is "hierarchical")
  // "manager_llm": "openai/gpt-4o",

  // Crew-level LLM fields also accept object form for custom endpoints
  // "chat_llm": {"model": "llama3", "provider": "ollama", "base_url": "http://localhost:11434"},

  // Advanced crew options:
  // Docs: https://docs.crewai.com/concepts/crews
  // For hierarchical crews, manager_agent can reference an agents/<name>.jsonc file
  // that is not included in the "agents" list.
  // "manager_agent": "productrequirements_agent",
  // "before_kickoff_callbacks": [{"python": "my_project.callbacks.before_kickoff"}],
  // "after_kickoff_callbacks": [{"python": "my_project.callbacks.after_kickoff"}],
  // "function_calling_llm": "openai/gpt-4o-mini",
  // "max_rpm": null,
  // "cache": true,
  // "knowledge_sources": [],
  // "embedder": {},
  // "output_log_file": "crew.log",
  // "stream": false,
  // "tracing": false,
  // "security_config": {},

  // Optional runtime input defaults.
  // Use {placeholder} in agent or task text, for example:
  // "description": "Research {topic} and write a brief"
  // `crewai run` prompts for any placeholders missing from this object.
  "inputs": {}
}
