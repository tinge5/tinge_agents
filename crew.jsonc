{
  // Display name for this crew
  "name": "tinge-agents",

  // Agents to include — each must have a matching agents/<name>.jsonc file
  "agents": ["productrequirements_agent",
              "architect_agent",
              "frontend_agent",
              "backend_agent",
              "testing_agent",
              "code_reviewer_agent"],

  // Task definitions — executed in order for sequential process
  "tasks": [
    /*
    
    {
      // Task identifier
      "name": "requirements_task",

      // What the task should accomplish
      // Use {placeholder} inputs here; crewai run prompts for missing values
      "description": "The current working directory is the root of the project being built. Use the current working directory (.) as the project root for any local file operations. Only access files and directories inside the current project. Do not access system root directories, parent directories, or directories outside the project. Analyze the user's application request: {app_description} Turn it into clear, specific, and testable software requirements. Identify the core features, users, inputs, outputs, constraints, business rules, and acceptance criteria. If an existing project is provided and local project inspection is necessary, only use appropriate local file and directory tools for local files; never use SerperDevTool, WebsiteSearchTool, ScrapeElementFromWebsiteTool, or any other web tool to read local files or directories. Web tools may only be used for genuine external HTTP or HTTPS websites when external research is necessary. Never pass ./MyApps/Workouts2.0/AgentFiles/requirements.md, file paths, relative paths, file:// URLs, or the project directory to a web tool. Do not make implementation decisions that belong to the Architect or developers. Focus on defining WHAT the application must do, not HOW it should be implemented. Provide a clear and complete set of requirements for the app {app_name} that can be used by the Architect and developers to design and implement the application. After completing the requirements analysis, use FileWriterTool to create or overwrite ./MyApps/Workouts2.0/AgentFiles/requirements.md in the current project root. This file must contain only the finalized requirements needed by downstream agents. Do not include internal reasoning, planning, tool history, or exploratory analysis. Do not consider the task complete until ./MyApps/Workouts2.0/AgentFiles/requirements.md has been successfully written.",
      // Clear definition of what the output should look like
      "expected_output": "A complete software requirements specification that clearly defines what the application needs to do, including existing functionality that should be preserved or modified.",

      // Optional task guardrail(s) validate output before completion
      // Use "guardrail" for one rule or "guardrails" for many
      // Failed guardrails retry up to guardrail_max_retries times
      // "guardrail": "Every factual claim needs context support.",
      // "guardrails": [
      //   "Every factual claim must be supported by context.",
      //   "The answer must match the expected output format."
      // ],
      // "guardrail_max_retries": 2,

      // Advanced task options:
      // Docs: https://docs.crewai.com/concepts/tasks
      // "type": "ConditionalTask",
      // "condition": { "python": "my_project.conditions.should_run" },
      // "output_json": { "python": "my_project.models.ReportOutput" },
      // "output_pydantic": null,
      // "response_model": null,
      // "converter_cls": { "python": "my_project.converters.CustomConverter" },
      // "markdown": false,
      // "input_files": { "brief": "data/brief.txt" },
      // "security_config": {},

      // Which agent handles this task
      "agent": "productrequirements_agent"

      // "tools": [],
      // "human_input": false,
      // "async_execution": false
    },
    

    {
      "name": "architecture_task",
      "description": "The current working directory is the root of the project. Read ./MyApps/Workouts2.0/AgentFiles/requirements.md from the current project root using FileReadTool and treat it as the only authoritative input for this task. Do not use DirectoryReadTool, do not use web tools, do not inspect any other files or directories, do not perform repository exploration, and do not repeat tool calls. Based only on ./MyApps/Workouts2.0/AgentFiles/requirements.md, design a concise implementation-ready technical architecture covering the technology stack, frontend and backend structure, database/data model, APIs, authentication and authorization, security, data flow, scheduling, recommendations, and major component relationships. Immediately after determining the architecture, use FileWriterTool to create  ./MyApps/Workouts2.0/AgentFiles/architecture.md in the current project root.  ./MyApps/Workouts2.0/AgentFiles/architecture.md must contain only the finalized architecture required by downstream implementation agents and must not contain internal reasoning, planning, tool history, or exploratory commentary. After writing  ./MyApps/Workouts2.0/AgentFiles/architecture.md, use FileReadTool exactly once to verify that  ./MyApps/Workouts2.0/AgentFiles/architecture.md exists and contains the finalized architecture. If verification succeeds, stop immediately. Do not perform any additional file or directory inspection. Do not consider the task complete until  ./MyApps/Workouts2.0/AgentFiles/architecture.md has been successfully created and verified.",
      "expected_output": "A detailed, implementation-ready technical architecture describing the technology stack, database/data model, APIs, components, data flow, authentication, security, and implementation structure, including which existing files should be preserved, modified, or created.",
      "agent": "architect_agent"
      //"context": ["requirements_task"]    
    },  
    
    
    {
      "name": "frontend_task",
      "description" : "Read ./MyApps/Workouts2.0/AgentFiles/requirements.md and  ./MyApps/Workouts2.0/AgentFiles/architecture.md from the current project root using FileReadTool. These are the only authoritative inputs for this task. Do not use DirectoryReadTool, do not use web tools, and do not perform repository exploration. Use FileReadTool only to read specific existing frontend files when necessary. This is a direct implementation task. Immediately use FileWriterTool to create or modify the complete runnable frontend application required by ./MyApps/Workouts2.0/AgentFiles/requirements.md and  ./MyApps/Workouts2.0/AgentFiles/architecture.md. You MUST write real frontend code and ALL required frontend project files, including package.json, framework configuration, entry points, configuration files, dependencies, screens, components, navigation, styling, state management, and API integration required by the architecture. The resulting frontend must be a complete runnable project, not merely source-code snippets. Do not create documentation or reports instead of code, do not merely describe the implementation, and do not stop after planning. If package.json or other required project configuration files do not exist, CREATE them. Do not assume required dependencies are already installed. After writing the implementation, use FileReadTool to verify package.json and the important frontend source/configuration files you created or modified, then STOP. Do not perform additional exploration after writing the code.",
      //"description": "Read ./App.tsx and ./app.json using FileReadTool. Create ./frontend and recreate the existing frontend implementation inside it without deleting or modifying the original files. Create a complete runnable Expo/React Native project under ./frontend, including package.json, App.tsx, app.json, tsconfig.json, src, assets, and any other files required by the existing frontend. Use FileWriterTool to write the actual files. Do not rebuild or redesign the application. Do not modify the backend files. After creating the frontend project, verify ./frontend/package.json and ./frontend/App.tsx with FileReadTool, then STOP.",
      "expected_output": "A functional implementation in the actual project files that satisfies the requirements, follows teh approved architecture, preserves appropriate existing functionality if applicable, and successfully builds or passes the relevant tests.",
      "agent": "frontend_agent"
      //"context": ["architecture_task"]    
    },
    {
      "name": "backend_task",
      "description": "Read ./MyApps/Workouts2.0/AgentFiles/requirements.md and  ./MyApps/Workouts2.0/AgentFiles/architecture.md from the current project root using FileReadTool. These are the only authoritative inputs for this task. Then use DirectoryReadTool exactly once on the current project root (.) only to identify the application files or directories that already exist. Do not call DirectoryReadTool again. Do not inspect .git, logs, reports, agent configuration, unrelated files, or any directory that is not directly relevant to the backend. Do not use wildcards, do not guess directories, and do not use web tools. After the single root listing, use FileReadTool only on the specific existing backend files needed to determine what must be preserved or modified. Do not perform further repository exploration. This is a direct implementation task. Immediately use FileWriterTool to create or modify the actual backend source files required by ./MyApps/Workouts2.0/AgentFiles/requirements.md and  ./MyApps/Workouts2.0/AgentFiles/architecture.md. You MUST write real backend application code to the project, including the required server structure, APIs, routes, services, models, database schema or migrations, authentication, authorization, and persistence logic defined by the architecture. Do not create documentation or reports instead of code, do not merely describe the implementation, and do not stop after planning. If the project has no existing backend implementation, create the required backend structure and source files based on  ./MyApps/Workouts2.0/AgentFiles/architecture.md. After writing the backend code, use FileReadTool to verify the important files you created or modified and then STOP. Do not call DirectoryReadTool again and do not perform additional exploration after writing the code.",
     //"description": "Read the existing backend files needed to understand the current implementation, then create ./backend and recreate the existing backend there. Preserve the existing functionality. Create all required backend files, including package.json, tsconfig.json, src, prisma, and configuration. Do not modify or delete the original backend files. Use FileWriterTool to write the actual files. Do not create reports, do not plan, and do not perform unnecessary exploration. Verify ./backend/package.json and ./backend/src exist using FileReadTool, then STOP.", 
     "expected_output": "A functional backend implementation in the actual project files that satisfies the requirements, follows the approved architecture, preserves appropriate existing functionality, and successfully runs or passes the relevant tests.",
      "agent": "backend_agent"
      //"context": ["architecture_task"]
    } /*,
    {
      "name": "testing_task",
      "description": "Read ./requirements.md and ./ ./MyApps/Workouts2.0/AgentFiles/architecture.md from the current project root using FileReadTool. These are the authoritative handoff documents for this task. Do not use DirectoryReadTool, do not use web tools, do not delegate to other agents, and do not perform repository exploration. Use FileReadTool to inspect the actual frontend and backend source files, configuration files, package files, and tests that are relevant to  ./MyApps/Workouts2.0/AgentFiles/requirements.md and  ./MyApps/Workouts2.0/AgentFiles/architecture.md. Determine what was actually implemented and compare it directly against the requirements and architecture. This is a QA task, not a planning or documentation task. Identify implemented requirements, missing functionality, bugs, security or privacy issues, integration problems, and unverified areas. Do not claim that a build, application startup, automated test, API request, browser test, or runtime behavior was executed unless an execution-capable tool actually performed it. Immediately use FileWriterTool to create or overwrite ./test-report.md containing the final QA findings, including passed items, failed items, unverified items, affected files, important edge cases, integration issues, and recommended fixes. Do not create additional reports or documentation. After writing ./test-report.md, use FileReadTool exactly once to verify the report exists and then STOP. Do not perform additional exploration after the report has been written.",
      "expected_output": "A detailed test report based on actual execution and project inspection, identifying passed requirements, failed tests, bugs, affected files or components, edge cases, integration issues, and recommended fixes.",
      "agent": "testing_agent"
      //"context": ["architecture_task"]
    },
    {
      "name": "code_review_task",
      "description": "Read ./requirements.md, ./ ./MyApps/Workouts2.0/AgentFiles/architecture.md, and ./test-report.md from the current project root using FileReadTool. These files are the authoritative requirements, architecture, and QA handoffs. Do not use DirectoryReadTool, do not use web tools, do not delegate to other agents, and do not perform repository exploration. Use FileReadTool to inspect the actual frontend and backend source files, configuration files, package files, and relevant tests referenced by the architecture or QA report. Independently compare the actual implementation against the requirements, architecture, and QA findings. This is a direct code-review task, not a planning task. Identify remaining bugs, missing requirements, security and privacy problems, authentication or authorization weaknesses, API and data issues, frontend/backend integration problems, architectural violations, poor implementation choices, and maintainability concerns. Do not rely solely on the QA report; verify important findings against the actual source code. Do not claim that code was executed, built, or runtime-tested unless an execution-capable tool actually performed that action. Immediately provide the final code review findings in the task output. Do not create unnecessary reports or documentation. After completing the review, STOP.",
      "expected_output": "A comprehensive code review based on the actual implementation, identifying security issues, bugs, architectural problems, maintainability concerns, deviations from requirements or architecture, and prioritized recommendations for final fixes.",
      "agent": "code_reviewer_agent"
      //"context": ["testing_task"]
    }
      
    {
      "name": "backend_continuation_task",
      "description": "Continue implementing the existing Workouts2.0 backend in ./MyApps/Workouts2.0/backend/. Do not recreate the backend, create a new backend directory, restart the implementation, or modify the working frontend. Read ./MyApps/Workouts2.0/AgentFiles/requirements.md and ./MyApps/Workouts2.0/AgentFiles/architecture.md as the authoritative requirements and implementation contract. Inspect the backend implementation produced by the previous continuation runs and build directly on the existing code. Do not replace working functionality unnecessarily. The previous runs have already established the Prisma/database foundation, authentication/session foundation, JWT guard, Prisma service, and Users, Plans, Workouts, Recommendations, History, and Archival controllers/services/modules. Your job now is to finish the actual required behavior rather than creating more scaffolding. Implement and complete full plan CRUD/update/delete, workout-day CRUD, exercise CRUD within plans, plan activation/deactivation and one-active-plan enforcement, current/today workout resolution using the required active-plan/week/day scheduling behavior, workout session creation/start/logging/completion, set-result creation and updates, derived exercise-history generation from completed workouts, workout history and exercise history queries, completed-plan history, plan completion detection, archival snapshots while preserving historical workout data, progressive-overload recommendations based on historical performance, recommendation snapshot persistence, user recommendation overrides, proper DTO validation and error handling throughout the API, and ownership/authorization enforcement across every user-scoped query and mutation. Ensure authenticated user identity is derived from the JWT rather than trusted from client-provided userId values. Compare the existing Prisma schema and relationships against architecture.md and make any necessary corrections so the schema supports the required behavior. Implement the actual business logic and persistence using NestJS and Prisma; do not use mock responses, hard-coded data, placeholder methods, empty modules, or documentation in place of functionality. Keep endpoint paths and HTTP methods consistent with architecture.md. Keep all changes under ./MyApps/Workouts2.0/backend/. Do not modify the frontend unless absolutely required for backend API compatibility. After implementation, inspect the resulting controllers, services, DTOs, guards, Prisma schema, and related files to verify that the previously identified incomplete requirements have actually been implemented. If execution tools are available, run the backend build and Prisma generation/migration checks; otherwise clearly state that execution verification could not be performed. Do not claim that code was built, tested, migrated, or executed unless it was actually done. Continue until the listed incomplete functionality has been implemented rather than stopping after creating additional scaffolding.",
      //"description": "Continue implementing the existing Workouts2.0 backend in ./MyApps/Workouts2.0/backend/. Do not recreate the backend, create a new backend directory, modify the working frontend, or start over. Read and use ./MyApps/Workouts2.0/AgentFiles/requirements.md and ./MyApps/Workouts2.0/AgentFiles/architecture.md as the authoritative requirements and implementation contract. Inspect the backend implementation produced by the previous backend task and continue from its current state. Preserve the completed Prisma, authentication, JWT, Argon2, and session functionality unless changes are required by the requirements or architecture. Implement the remaining application functionality, including Users/Profile APIs, Plans CRUD and activation/deactivation, workout-day and exercise management, current/today workout resolution, workout sessions, set logging and completion, workout history, exercise history, completed-plan history, recommendations, progressive overload based on historical performance, recommendation snapshots, plan completion detection, archival/snapshots, and all corresponding REST endpoints defined in architecture.md. Implement the actual NestJS controllers, services, DTOs/validation, guards/authorization, business logic, Prisma persistence, relationships, and error handling rather than placeholders, mock responses, or empty modules. Enforce authenticated-user ownership and derive user identity from the authenticated JWT rather than trusting userId supplied by the client. Enforce one active plan per user, preserve historical workout data after plan completion/archival, and follow the scheduling, recommendation, progressive-overload, and insufficient-history behavior specified in the requirements and architecture. Compare the existing Prisma schema against architecture.md and make any necessary compatible corrections. Keep all backend changes under ./MyApps/Workouts2.0/backend/. After implementation, inspect the resulting files and verify that the required controllers, services, Prisma models, endpoints, guards, and business logic are actually present. If execution tools are available, run the backend build and Prisma generation/migration checks; otherwise clearly report what could not be executed. Do not claim tests or builds were performed unless they were actually executed. Continue until the remaining backend functionality is implemented rather than stopping after creating scaffolding.",
      "expected_output": "A completed backend implementation in ./MyApps/Workouts2.0/backend that satisfies the existing requirements and architecture, preserves working functionality, implements the missing backend APIs and business logic, and successfully builds or passes the relevant verification.",
      "agent": "backend_agent"
    }
    */
    {
      "name": "Plans Feature Integration",
      "description": "Update the Workouts2.0 frontend and, only where required by the actual backend implementation, backend workout/plan logic so the Today screen displays the authenticated user's correct scheduled workout for the current day and active plan; add a configurable plan duration in weeks when creating/editing a plan; allow users to preview future weeks of the active plan such as Week 1, Week 2, Week 3, etc.; ensure Progressive Overload actually changes the planned workout values across future weeks according to the application's intended progression rules; add a clear week selector/preview in the Plans experience; do not require users to manually enter or edit Week Index, since week progression should be calculated automatically from the plan's duration and the user's current progress/start date; inspect the actual implementation before making changes, including ./MyApps/Workouts2.0/frontend/src/features/plans/PlanEditorScreen.tsx, ./MyApps/Workouts2.0/frontend/src/features/workouts/TodayScreen.tsx, ./MyApps/Workouts2.0/frontend/src/shared/api/client.ts, ./MyApps/Workouts2.0/backend/src/modules/plans/plans.controller.ts, ./MyApps/Workouts2.0/backend/src/modules/plans/plans.service.ts, ./MyApps/Workouts2.0/backend/src/modules/workouts/workouts.controller.ts, ./MyApps/Workouts2.0/backend/src/modules/workouts/workouts.service.ts, relevant DTOs under ./MyApps/Workouts2.0/backend/src/modules/plans/ and ./MyApps/Workouts2.0/backend/src/modules/workouts/, and ./MyApps/Workouts2.0/backend/prisma/schema.prisma; match the existing backend contract and do not invent API endpoints or data structures; preserve the working authentication, Plans CRUD, exercise autocomplete, boolean dropdowns, activate/deactivate functionality, and existing UI design.",
      "expected_output": "Update the relevant existing files under ./MyApps/Workouts2.0/ rather than creating a separate implementation. At minimum, update ./MyApps/Workouts2.0/frontend/src/features/workouts/TodayScreen.tsx, ./MyApps/Workouts2.0/frontend/src/features/plans/PlanEditorScreen.tsx, and ./MyApps/Workouts2.0/frontend/src/shared/api/client.ts as needed; update the actual backend files under ./MyApps/Workouts2.0/backend/src/modules/plans/ and ./MyApps/Workouts2.0/backend/src/modules/workouts/ only if the existing backend does not already support the required duration, week scheduling, current-workout resolution, or progressive-overload behavior. The completed implementation must make Today display the correct workout for the authenticated user's current day/week, allow a plan duration such as 4, 8, or 12 weeks to be configured, allow future weeks to be previewed without modifying the plan, visibly demonstrate the expected Progressive Overload changes between weeks when enabled, automatically determine the current week instead of requiring manual Week Index input, and keep all existing Plans functionality working. Report the exact relative paths of every file actually changed, summarize what was changed in each file, explain how current-week and future-week progression works, and state exactly what was tested and whether any build/runtime verification could not be performed.",
      "agent": "frontend_agent"
    }
    
  ],

  // Execution process
  // "sequential" — tasks run in order, each receiving prior task outputs
  // "hierarchical" — a manager agent delegates tasks (requires manager_llm)
  "process": "sequential",

  // Enable verbose logging during execution
  "verbose": true,

  // Enable crew memory — persists context and learnings across tasks
  "memory": false,

  // Automatically plan the execution strategy before running tasks
   "planning": false,

  // LLM for the planning step (used when planning is true)
  // "planning_llm": "openai/gpt-4o",

  // LLM for the manager agent (required when process is "hierarchical")
  // "manager_llm": "openai/gpt-4o",

  // Crew-level LLM fields also accept object form for custom endpoints
  // "chat_llm": {"model": "llama3", "provider": "ollama", "base_url": "http://localhost:11434"},

  // Advanced crew options:
  // Docs: https://docs.crewai.com/concepts/crews
  // For hierarchical crews, manager_agent can reference an agents/<name>.jsonc file
  // that is not included in the "agents" list.
  // "manager_agent": "productrequirements_agent",
  // "before_kickoff_callbacks": [{"python": "my_project.callbacks.before_kickoff"}],
  // "after_kickoff_callbacks": [{"python": "my_project.callbacks.after_kickoff"}],
  // "function_calling_llm": "openai/gpt-4o-mini",
  // "max_rpm": null,
  // "cache": true,
  // "knowledge_sources": [],
  // "embedder": {},
  // "output_log_file": "crew.log",
  // "stream": false,
  // "tracing": false,
  // "security_config": {},

  // Optional runtime input defaults.
  // Use {placeholder} in agent or task text, for example:
  // "description": "Research {topic} and write a brief"
  // `crewai run` prompts for any placeholders missing from this object.
  "inputs": {}
}
