{
  // Display name for this crew
  "name": "tinge-agents",

  // Agents to include — each must have a matching agents/<name>.jsonc file
  "agents": ["productrequirements_agent",
              "architect_agent",
              "frontend_agent",
              "backend_agent",
              "testing_agent",
              "code_reviewer_agent"],

  // Task definitions — executed in order for sequential process
  "tasks": [
    /*
    
    {
      // Task identifier
      "name": "requirements_task",

      // What the task should accomplish
      // Use {placeholder} inputs here; crewai run prompts for missing values
      "description": "The current working directory is the root of the project being built. Use the current working directory (.) as the project root for any local file operations. Only access files and directories inside the current project. Do not access system root directories, parent directories, or directories outside the project. Analyze the user's application request: {app_description} Turn it into clear, specific, and testable software requirements. Identify the core features, users, inputs, outputs, constraints, business rules, and acceptance criteria. If an existing project is provided and local project inspection is necessary, only use appropriate local file and directory tools for local files; never use SerperDevTool, WebsiteSearchTool, ScrapeElementFromWebsiteTool, or any other web tool to read local files or directories. Web tools may only be used for genuine external HTTP or HTTPS websites when external research is necessary. Never pass requirements.md, file paths, relative paths, file:// URLs, or the project directory to a web tool. Do not make implementation decisions that belong to the Architect or developers. Focus on defining WHAT the application must do, not HOW it should be implemented. Provide a clear and complete set of requirements for the app {app_name} that can be used by the Architect and developers to design and implement the application. After completing the requirements analysis, use FileWriterTool to create or overwrite requirements.md in the current project root. This file must contain only the finalized requirements needed by downstream agents. Do not include internal reasoning, planning, tool history, or exploratory analysis. Do not consider the task complete until requirements.md has been successfully written.",
      // Clear definition of what the output should look like
      "expected_output": "A complete software requirements specification that clearly defines what the application needs to do, including existing functionality that should be preserved or modified.",

      // Optional task guardrail(s) validate output before completion
      // Use "guardrail" for one rule or "guardrails" for many
      // Failed guardrails retry up to guardrail_max_retries times
      // "guardrail": "Every factual claim needs context support.",
      // "guardrails": [
      //   "Every factual claim must be supported by context.",
      //   "The answer must match the expected output format."
      // ],
      // "guardrail_max_retries": 2,

      // Advanced task options:
      // Docs: https://docs.crewai.com/concepts/tasks
      // "type": "ConditionalTask",
      // "condition": { "python": "my_project.conditions.should_run" },
      // "output_json": { "python": "my_project.models.ReportOutput" },
      // "output_pydantic": null,
      // "response_model": null,
      // "converter_cls": { "python": "my_project.converters.CustomConverter" },
      // "markdown": false,
      // "input_files": { "brief": "data/brief.txt" },
      // "security_config": {},

      // Which agent handles this task
      "agent": "productrequirements_agent"

      // "tools": [],
      // "human_input": false,
      // "async_execution": false
    },
    

    {
      "name": "architecture_task",
      "description": "The current working directory is the root of the project. Read requirements.md from the current project root using FileReadTool and treat it as the only authoritative input for this task. Do not use DirectoryReadTool, do not use web tools, do not inspect any other files or directories, do not perform repository exploration, and do not repeat tool calls. Based only on requirements.md, design a concise implementation-ready technical architecture covering the technology stack, frontend and backend structure, database/data model, APIs, authentication and authorization, security, data flow, scheduling, recommendations, and major component relationships. Immediately after determining the architecture, use FileWriterTool to create architecture.md in the current project root. architecture.md must contain only the finalized architecture required by downstream implementation agents and must not contain internal reasoning, planning, tool history, or exploratory commentary. After writing architecture.md, use FileReadTool exactly once to verify that architecture.md exists and contains the finalized architecture. If verification succeeds, stop immediately. Do not perform any additional file or directory inspection. Do not consider the task complete until architecture.md has been successfully created and verified.",
      "expected_output": "A detailed, implementation-ready technical architecture describing the technology stack, database/data model, APIs, components, data flow, authentication, security, and implementation structure, including which existing files should be preserved, modified, or created.",
      "agent": "architect_agent"
      //"context": ["requirements_task"]    
    },  
    */
    
    {
      "name": "frontend_task",
      //"description" : "Read requirements.md and architecture.md from the current project root using FileReadTool. These are the only authoritative inputs for this task. Do not use DirectoryReadTool, do not use web tools, and do not perform repository exploration. Use FileReadTool only to read specific existing frontend files when necessary. This is a direct implementation task. Immediately use FileWriterTool to create or modify the complete runnable frontend application required by requirements.md and architecture.md. You MUST write real frontend code and ALL required frontend project files, including package.json, framework configuration, entry points, configuration files, dependencies, screens, components, navigation, styling, state management, and API integration required by the architecture. The resulting frontend must be a complete runnable project, not merely source-code snippets. Do not create documentation or reports instead of code, do not merely describe the implementation, and do not stop after planning. If package.json or other required project configuration files do not exist, CREATE them. Do not assume required dependencies are already installed. After writing the implementation, use FileReadTool to verify package.json and the important frontend source/configuration files you created or modified, then STOP. Do not perform additional exploration after writing the code.",
      "description" : "Read ./requirements.md and ./architecture.md using FileReadTool. Then inspect the existing App.tsx and app.json using FileReadTool. This is a focused frontend setup task. Do not use DirectoryReadTool, do not use web tools, and do not inspect unrelated files. The existing frontend files are currently in the project root and must remain there for this task. Create the missing frontend package.json in the project root with the correct Expo, React, and React Native dependencies required by the existing App.tsx and app.json. Do not modify, delete, or replace the backend package configuration or backend source files. Use FileWriterTool to create the actual package.json. Do not create a report or merely describe the solution. After writing package.json, use FileReadTool once to verify it exists and contains the required frontend configuration, then STOP.",
      "expected_output": "A functional implementation in the actual project files that satisfies the requirements, follows teh approved architecture, preserves appropriate existing functionality if applicable, and successfully builds or passes the relevant tests.",
      "agent": "frontend_agent"
      //"context": ["architecture_task"]    
    }/*,
    {
      "name": "backend_task",
      "description": "Read requirements.md and architecture.md from the current project root using FileReadTool. These are the only authoritative inputs for this task. Then use DirectoryReadTool exactly once on the current project root (.) only to identify the application files or directories that already exist. Do not call DirectoryReadTool again. Do not inspect .git, logs, reports, agent configuration, unrelated files, or any directory that is not directly relevant to the backend. Do not use wildcards, do not guess directories, and do not use web tools. After the single root listing, use FileReadTool only on the specific existing backend files needed to determine what must be preserved or modified. Do not perform further repository exploration. This is a direct implementation task. Immediately use FileWriterTool to create or modify the actual backend source files required by requirements.md and architecture.md. You MUST write real backend application code to the project, including the required server structure, APIs, routes, services, models, database schema or migrations, authentication, authorization, and persistence logic defined by the architecture. Do not create documentation or reports instead of code, do not merely describe the implementation, and do not stop after planning. If the project has no existing backend implementation, create the required backend structure and source files based on architecture.md. After writing the backend code, use FileReadTool to verify the important files you created or modified and then STOP. Do not call DirectoryReadTool again and do not perform additional exploration after writing the code.",
      "expected_output": "A functional backend implementation in the actual project files that satisfies the requirements, follows the approved architecture, preserves appropriate existing functionality, and successfully runs or passes the relevant tests.",
      "agent": "backend_agent"
      //"context": ["architecture_task"]
    },
    {
      "name": "testing_task",
      "description": "Read ./requirements.md and ./architecture.md from the current project root using FileReadTool. These are the authoritative handoff documents for this task. Do not use DirectoryReadTool, do not use web tools, do not delegate to other agents, and do not perform repository exploration. Use FileReadTool to inspect the actual frontend and backend source files, configuration files, package files, and tests that are relevant to requirements.md and architecture.md. Determine what was actually implemented and compare it directly against the requirements and architecture. This is a QA task, not a planning or documentation task. Identify implemented requirements, missing functionality, bugs, security or privacy issues, integration problems, and unverified areas. Do not claim that a build, application startup, automated test, API request, browser test, or runtime behavior was executed unless an execution-capable tool actually performed it. Immediately use FileWriterTool to create or overwrite ./test-report.md containing the final QA findings, including passed items, failed items, unverified items, affected files, important edge cases, integration issues, and recommended fixes. Do not create additional reports or documentation. After writing ./test-report.md, use FileReadTool exactly once to verify the report exists and then STOP. Do not perform additional exploration after the report has been written.",
      "expected_output": "A detailed test report based on actual execution and project inspection, identifying passed requirements, failed tests, bugs, affected files or components, edge cases, integration issues, and recommended fixes.",
      "agent": "testing_agent"
      //"context": ["architecture_task"]
    },
    {
      "name": "code_review_task",
      "description": "Read ./requirements.md, ./architecture.md, and ./test-report.md from the current project root using FileReadTool. These files are the authoritative requirements, architecture, and QA handoffs. Do not use DirectoryReadTool, do not use web tools, do not delegate to other agents, and do not perform repository exploration. Use FileReadTool to inspect the actual frontend and backend source files, configuration files, package files, and relevant tests referenced by the architecture or QA report. Independently compare the actual implementation against the requirements, architecture, and QA findings. This is a direct code-review task, not a planning task. Identify remaining bugs, missing requirements, security and privacy problems, authentication or authorization weaknesses, API and data issues, frontend/backend integration problems, architectural violations, poor implementation choices, and maintainability concerns. Do not rely solely on the QA report; verify important findings against the actual source code. Do not claim that code was executed, built, or runtime-tested unless an execution-capable tool actually performed that action. Immediately provide the final code review findings in the task output. Do not create unnecessary reports or documentation. After completing the review, STOP.",
      "expected_output": "A comprehensive code review based on the actual implementation, identifying security issues, bugs, architectural problems, maintainability concerns, deviations from requirements or architecture, and prioritized recommendations for final fixes.",
      "agent": "code_reviewer_agent"
      //"context": ["testing_task"]
    }
      */
  ],

  // Execution process
  // "sequential" — tasks run in order, each receiving prior task outputs
  // "hierarchical" — a manager agent delegates tasks (requires manager_llm)
  "process": "sequential",

  // Enable verbose logging during execution
  "verbose": true,

  // Enable crew memory — persists context and learnings across tasks
  "memory": false,

  // Automatically plan the execution strategy before running tasks
   "planning": false,

  // LLM for the planning step (used when planning is true)
  // "planning_llm": "openai/gpt-4o",

  // LLM for the manager agent (required when process is "hierarchical")
  // "manager_llm": "openai/gpt-4o",

  // Crew-level LLM fields also accept object form for custom endpoints
  // "chat_llm": {"model": "llama3", "provider": "ollama", "base_url": "http://localhost:11434"},

  // Advanced crew options:
  // Docs: https://docs.crewai.com/concepts/crews
  // For hierarchical crews, manager_agent can reference an agents/<name>.jsonc file
  // that is not included in the "agents" list.
  // "manager_agent": "productrequirements_agent",
  // "before_kickoff_callbacks": [{"python": "my_project.callbacks.before_kickoff"}],
  // "after_kickoff_callbacks": [{"python": "my_project.callbacks.after_kickoff"}],
  // "function_calling_llm": "openai/gpt-4o-mini",
  // "max_rpm": null,
  // "cache": true,
  // "knowledge_sources": [],
  // "embedder": {},
  // "output_log_file": "crew.log",
  // "stream": false,
  // "tracing": false,
  // "security_config": {},

  // Optional runtime input defaults.
  // Use {placeholder} in agent or task text, for example:
  // "description": "Research {topic} and write a brief"
  // `crewai run` prompts for any placeholders missing from this object.
  "inputs": {}
}
